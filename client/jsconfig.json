{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "checkJs": true, // 取消在 jsx 文件中检查 ts 数据类型
        "jsx": "react-jsx",
        "moduleResolution": "node",
        "baseUrl": "/",
        "paths": {
            "@/*": ["src/_assets/*"]
        },
        "types": ["vite/client"]
    },
    "include": [
        "src",
        "global.d.ts",
        "src/layouts/dashboard/dashboard-personal-plan/.jsx"
    ]
}
